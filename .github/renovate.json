{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"helpers:pinGitHubActionDigests"
	],
	"labels": [
		"dependencies"
	],
	"packageRules": [
		{
			"matchManagers": [
				"dockerfile"
			],
			"pinDigests": true
		},
		{
			"description": "Digests change only together with their versions: a digest refresh alone would rebuild and release an otherwise unchanged image, and for an action it means that a tag moved.",
			"matchManagers": [
				"dockerfile",
				"github-actions"
			],
			"matchUpdateTypes": [
				"digest"
			],
			"enabled": false
		},
		{
			"description": "One pull request bumps the Rust toolchain pin and the Dockerfile's rust build image together; they must match.",
			"matchPackageNames": [
				"rust",
				"docker.io/rust"
			],
			"groupName": "Rust toolchain"
		},
		{
			"description": "The local stack and the contract tests run the same Forgejo.",
			"matchPackageNames": [
				"data.forgejo.org/forgejo/forgejo"
			],
			"groupName": "Forgejo"
		},
		{
			"description": "Pi, Claude Code and Node.js only go into the unpublished development image, which CI builds and smoke-tests: merge minor and patch bumps once checks pass.",
			"matchPackageNames": [
				"@earendil-works/pi-coding-agent",
				"@anthropic-ai/claude-code",
				"docker.io/node"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"automerge": true
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": [
				".github/workflows/rust.yml"
			],
			"matchStrings": [
				"CARGO_DENY_VERSION: \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
			],
			"datasourceTemplate": "crate",
			"depNameTemplate": "cargo-deny",
			"versioningTemplate": "semver"
		},
		{
			"customType": "regex",
			"managerFilePatterns": [
				"rust-toolchain.toml"
			],
			"matchStrings": [
				"channel = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
			],
			"datasourceTemplate": "docker",
			"depNameTemplate": "rust",
			"packageNameTemplate": "docker.io/rust",
			"versioningTemplate": "docker"
		},
		{
			"customType": "regex",
			"managerFilePatterns": [
				"scripts/forgejo-test.sh"
			],
			"matchStrings": [
				"ARTIDEZI_FORGEJO_IMAGE:-data\\.forgejo\\.org/forgejo/forgejo:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
			],
			"datasourceTemplate": "docker",
			"depNameTemplate": "data.forgejo.org/forgejo/forgejo",
			"versioningTemplate": "docker"
		},
		{
			"customType": "regex",
			"managerFilePatterns": [
				"Dockerfile"
			],
			"matchStrings": [
				"@earendil-works/pi-coding-agent@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
			],
			"datasourceTemplate": "npm",
			"depNameTemplate": "@earendil-works/pi-coding-agent",
			"versioningTemplate": "semver"
		},
		{
			"customType": "regex",
			"description": "The image installs the per-architecture native package; track the x64 one, which is published together with the others.",
			"managerFilePatterns": [
				"Dockerfile"
			],
			"matchStrings": [
				"@anthropic-ai/claude-code-linux-\\$\\{claude_arch\\}@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
			],
			"datasourceTemplate": "npm",
			"depNameTemplate": "@anthropic-ai/claude-code",
			"packageNameTemplate": "@anthropic-ai/claude-code-linux-x64",
			"versioningTemplate": "semver"
		}
	],
	"prConcurrentLimit": 3,
	"rebaseWhen": "behind-base-branch",
	"automerge": false,
	"lockFileMaintenance": {
		"enabled": true
	}
}
